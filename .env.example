# AI Labor Observatory — Environment Variables (Public Demo Edition)
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For the LOCAL DEMO (synthetic data, no external calls):
#   Only the classification keys are needed.
#   Supabase and Apify keys are only required for the full live pipeline,
#   which is NOT included in this public release.

# ================================================================
# OPENROUTER (required for LLM classification)
# ================================================================
# API key from https://openrouter.ai/settings/keys
# Recommended: set a monthly spend limit on the key itself.
OPENROUTER_API_KEY=<your-openrouter-api-key>

# Default classification model (must be available on OpenRouter)
CLASSIFICATION_MODEL=openai/gpt-3.5-turbo

# ================================================================
# BUDGET CONTROLS
# ================================================================
# Hard stop on estimated LLM cost per pipeline run (USD).
RUN_BUDGET_USD=5.0

# Hard stop on total LLM API calls per run.
MAX_LLM_CALLS_PER_RUN=500

# Approximate cost per 1k tokens (adjust to your model/plan).
APPROX_COST_PER_1K_TOKENS_USD=0.001

# ================================================================
# CLASSIFICATION THRESHOLDS
# ================================================================
CONFIDENCE_THRESHOLD=0.7

# ================================================================
# LOGGING
# ================================================================
LOG_LEVEL=INFO

# ================================================================
# NOT REQUIRED FOR DEMO — full pipeline only
# ================================================================
# Uncomment and fill these only if you are running the full live pipeline
# (scraping + DB) which is NOT part of this public release.
#
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_ANON_KEY=<your-supabase-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
#
# APIFY_TOKEN=<your-apify-token>
# APIFY_ACTOR_LINKEDIN_JOBS=<actor-id>
# APIFY_ACTOR_INDEED=<actor-id>
# Note: using Apify to scrape LinkedIn/Indeed may violate those platforms'
# Terms of Service. Obtain legal advice before activating these connectors.
